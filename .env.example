# LLM Provider Configuration (Local Llama via Ollama - default)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Fallback to OpenAI if desired
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL_NAME=gpt-4o-mini

# Django Settings
SECRET_KEY=django-insecure-multi-agent-secret-key-change-in-production
DEBUG=True
